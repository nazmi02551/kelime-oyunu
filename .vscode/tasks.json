{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🤖 Update Copilot Instructions",
      "type": "shell",
      "command": "code",
      "args": [
        "--open-url",
        "vscode://github.copilot.chat?prompt=@workspace%20.github/prompts/update-instructions.prompt.md%20dosyasındaki%20talimatlara%20göre%20copilot-instructions.md'yi%20güncelle"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "🔍 Check Instructions Age",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "$file = '.github/copilot-instructions.md'; $days = (New-TimeSpan -Start (Get-Item $file).LastWriteTime -End (Get-Date)).Days; Write-Host \"📅 Copilot Instructions son güncelleme: $days gün önce\" -ForegroundColor $(if($days -gt 30){'Red'}elseif($days -gt 14){'Yellow'}else{'Green'})"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
